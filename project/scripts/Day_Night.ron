(
    name: "Day Night",
    enabled: true,
    description: "World rule: advances the time of day (one cycle every 240 s).",
    on_start: [
        SetVar(
            name: "time",
            value: 0.3,
        ),
        SetTimeOfDay(
            value: 0.3,
        ),
    ],
    on_tick: [
        Wait(
            seconds: 1.0,
        ),
        AddVar(
            name: "time",
            value: 0.004166667,
        ),
        Math(
            name: "time",
            op: Mod,
            value: 1.0,
        ),
        SetTimeOfDay(
            value: -1.0,
        ),
    ],
    on_interact: [],
    on_hit: [],
    on_signal: [],
    signal_port: "",
    on_energy: [],
    bound: false,
)